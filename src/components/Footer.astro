---
---

<footer class="border-t border-[#2a2a2a] bg-[#0a0a0a] py-16 px-4 sm:px-6 lg:px-8 mt-auto">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-[#191919]">
      <!-- Brand column -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-7 h-7 rounded-[6px] bg-[#191919] border border-[#2a2a2a] flex items-center justify-center">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="text-white">
              <path d="M4 6H20M4 12H15M4 18H20" stroke-linecap="round"/>
              <circle cx="19" cy="12" r="2" fill="currentColor" />
            </svg>
          </div>
          <span class="font-semibold text-sm tracking-tight text-[#fafafa]">NotionIQ</span>
        </div>
        <p class="text-sm text-[#7a7a7a] max-w-sm leading-relaxed">
          High-precision AI cognitive workspace. Transform unstructured technical docs, study notes, and research papers into instant knowledge synthesis and active recall quizzes.
        </p>
        <div class="flex items-center gap-2 pt-2">
          <div class="w-2 h-2 rounded-full bg-[#fafafa]/80 animate-pulse"></div>
          <span class="font-mono text-xs text-[#7a7a7a]">Deterministic Engine Online</span>
        </div>
      </div>

      <!-- Navigation Column -->
      <div class="space-y-3">
        <h4 class="font-mono text-xs uppercase tracking-wider text-[#b0b0b0]">Platform</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/" class="text-[#7a7a7a] hover:text-[#fafafa] transition-colors">Home</a></li>
          <li><a href="/about" class="text-[#7a7a7a] hover:text-[#fafafa] transition-colors">Philosophy & Engine</a></li>
          <li><a href="/workspace" class="text-[#7a7a7a] hover:text-[#fafafa] transition-colors">Live Workspace</a></li>
          <li><a href="/quiz" class="text-[#7a7a7a] hover:text-[#fafafa] transition-colors">Interactive Quiz</a></li>
        </ul>
      </div>

      <!-- Resources Column -->
      <div class="space-y-3">
        <h4 class="font-mono text-xs uppercase tracking-wider text-[#b0b0b0]">Access & Security</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/signin" class="text-[#7a7a7a] hover:text-[#fafafa] transition-colors">Account Sign In</a></li>
          <li><a href="/signup" class="text-[#7a7a7a] hover:text-[#fafafa] transition-colors">Create Workspace</a></li>
          <li><span class="text-[#525252] cursor-not-allowed">API Documentation (Soon)</span></li>
          <li><span class="text-[#525252] cursor-not-allowed">SOC2 Compliance</span></li>
        </ul>
      </div>
    </div>

    <!-- Bottom credits -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#525252]">
      <p>© {new Date().getFullYear()} NotionIQ Inc. Built with pure grayscale discipline per DESIGN.md.</p>
      <div class="flex items-center gap-6 font-mono text-[11px]">
        <span>LATENCY: &lt;140ms</span>
        <span>SYSTEM: MONOCHROME</span>
        <span>VERSION: 2.0.4</span>
      </div>
    </div>
  </div>
</footer>
