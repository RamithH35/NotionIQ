---
import Button from './Button.astro';

const pathname = Astro.url.pathname;
const cleanPath = pathname.endsWith('/') && pathname.length > 1 ? pathname.slice(0, -1) : pathname;

const navItems = [
  { name: 'Home', href: '/' },
  { name: 'About', href: '/about' },
  { name: 'Workspace', href: '/workspace' },
  { name: 'Quiz Demo', href: '/quiz' },
];
---

<header class="sticky top-0 z-50 w-full border-b border-[#2a2a2a] bg-[#0a0a0a]/80 backdrop-blur-md">
  <div class="max-w-7xl mx-auto flex h-16 items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group text-decoration-none">
      <div class="w-8 h-8 rounded-[6px] bg-[#191919] border border-[#2a2a2a] group-hover:border-[#3a3a3a] flex items-center justify-center transition-colors">
        <!-- Monochrome SVG geometric logo glyph -->
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-white">
          <path d="M4 6H20M4 12H15M4 18H20" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
          <circle cx="19" cy="12" r="2" fill="currentColor" />
        </svg>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="font-semibold text-base tracking-tight text-[#fafafa]">NotionIQ</span>
        <span class="font-mono text-[10px] uppercase tracking-wider text-[#7a7a7a] px-1.5 py-0.5 rounded-[4px] bg-[#191919] border border-[#2a2a2a]">v2.0</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-1">
      {navItems.map((item) => {
        const isActive = cleanPath === item.href;
        return (
          <a
            href={item.href}
            class={`px-3 py-1.5 rounded-[6px] text-sm font-normal transition-all relative ${
              isActive
                ? 'text-[#fafafa] bg-[#191919] font-medium'
                : 'text-[#b0b0b0] hover:text-[#fafafa] hover:bg-[#121212]'
            }`}
          >
            {item.name}
            {isActive && (
              <span class="absolute bottom-0 left-3 right-3 h-[1px] bg-[#fafafa]/60"></span>
            )}
          </a>
        );
      })}
    </nav>

    <!-- Right Action Buttons -->
    <div class="hidden sm:flex items-center gap-3" id="nav-auth-container">
      <div id="nav-guest-actions" class="flex items-center gap-3">
        <Button href="/signin" variant="secondary-square" id="nav-signin-btn">
          Sign In
        </Button>
        <Button href="/signup" variant="primary-pill" id="nav-get-started-btn">
          Get Started
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </Button>
      </div>
      <div id="nav-user-actions" class="hidden items-center gap-3">
        <span id="nav-user-name" class="font-mono text-xs text-[#fafafa] px-2.5 py-1 rounded-[6px] bg-[#191919] border border-[#2a2a2a]"></span>
        <button
          type="button"
          id="nav-logout-btn"
          class="btn-secondary-square !h-8 !px-3 text-xs"
        >
          Sign Out
        </button>
      </div>
    </div>

    <!-- Mobile Menu Trigger Button -->
    <div class="flex sm:hidden">
      <button
        type="button"
        id="mobile-menu-toggle"
        class="w-9 h-9 rounded-[6px] bg-[#121212] border border-[#2a2a2a] flex items-center justify-center text-[#fafafa] hover:bg-[#191919] transition-colors"
        aria-label="Toggle Navigation Menu"
      >
        <svg id="hamburger-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="18" x2="20" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden sm:hidden border-b border-[#2a2a2a] bg-[#0a0a0a] px-4 pt-2 pb-6 space-y-3">
    <div class="flex flex-col space-y-1">
      {navItems.map((item) => {
        const isActive = cleanPath === item.href;
        return (
          <a
            href={item.href}
            class={`px-3 py-2 rounded-[6px] text-sm ${
              isActive
                ? 'text-[#fafafa] bg-[#191919] font-medium'
                : 'text-[#b0b0b0] hover:text-[#fafafa] hover:bg-[#121212]'
            }`}
          >
            {item.name}
          </a>
        );
      })}
    </div>
    <div class="pt-3 border-t border-[#2a2a2a] flex flex-col gap-2" id="mobile-auth-container">
      <Button href="/signin" variant="secondary-square" class="w-full justify-center">
        Sign In
      </Button>
      <Button href="/signup" variant="primary-pill" class="w-full justify-center">
        Get Started Free
      </Button>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const guestActions = document.getElementById('nav-guest-actions');
  const userActions = document.getElementById('nav-user-actions');
  const userNameSpan = document.getElementById('nav-user-name');
  const logoutBtn = document.getElementById('nav-logout-btn');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }

  // Check current session state via GET /api/me
  fetch('/api/me', { credentials: 'include' })
    .then((res) => (res.ok ? res.json() : null))
    .then((data) => {
      if (data && data.user) {
        if (guestActions) guestActions.classList.add('hidden');
        if (userActions) {
          userActions.classList.remove('hidden');
          userActions.classList.add('flex');
        }
        if (userNameSpan) {
          userNameSpan.textContent = data.user.name;
        }
      }
    })
    .catch(() => {});

  if (logoutBtn) {
    logoutBtn.addEventListener('click', () => {
      fetch('/api/logout', { method: 'POST', credentials: 'include' })
        .finally(() => {
          window.location.href = '/signin';
        });
    });
  }
</script>
