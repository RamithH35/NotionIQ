---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
---

<Layout title="Sign Up — NotionIQ" hideFooter={true}>
  <div class="min-h-[calc(100vh-4rem)] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    <!-- Subtle Background Glow -->
    <div class="hero-glow-backdrop !top-[-180px] !w-[600px] !h-[400px]"></div>

    <div class="w-full max-w-md relative z-10">
      <!-- Centered Glassy Form Card -->
      <Card variant="featured-glassy" class="!p-8 sm:!p-10 space-y-8 bg-[#121212] border border-[#2a2a2a]">
        <div class="text-center space-y-2">
          <div class="w-10 h-10 rounded-[6px] bg-[#191919] border border-[#2a2a2a] flex items-center justify-center mx-auto mb-4 text-white">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 6H20M4 12H15M4 18H20" stroke-linecap="round"/>
              <circle cx="19" cy="12" r="2" fill="currentColor" />
            </svg>
          </div>
          <h1 class="text-2xl font-semibold tracking-heading-md text-[#fafafa]">
            Create your workspace
          </h1>
          <p class="text-xs text-[#7a7a7a]">
            Get started with AI-driven document synthesis and testing
          </p>
        </div>

        <!-- Form with Inline Validation -->
        <form id="signup-form" class="space-y-4" novalidate>
          <div class="space-y-1.5">
            <label for="name" class="block text-xs font-medium text-[#b0b0b0]">
              Full name
            </label>
            <input
              type="text"
              id="name"
              name="name"
              autocomplete="name"
              required
              placeholder="Alex Vance"
              class="w-full px-3.5 py-2.5 rounded-[6px] bg-[#191919] border border-[#2a2a2a] text-sm text-[#fafafa] placeholder-[#525252] focus:outline-none focus:border-[#fafafa] transition-colors"
            />
            <div id="name-error" class="hidden text-xs text-[#e5484d] pt-1">
              Please enter your full name.
            </div>
          </div>

          <div class="space-y-1.5">
            <label for="signup-email" class="block text-xs font-medium text-[#b0b0b0]">
              Email address
            </label>
            <input
              type="email"
              id="signup-email"
              name="email"
              autocomplete="email"
              required
              placeholder="alex@example.com"
              class="w-full px-3.5 py-2.5 rounded-[6px] bg-[#191919] border border-[#2a2a2a] text-sm text-[#fafafa] placeholder-[#525252] focus:outline-none focus:border-[#fafafa] transition-colors"
            />
            <div id="signup-email-error" class="hidden text-xs text-[#e5484d] pt-1">
              Please enter a valid email address.
            </div>
          </div>

          <div class="space-y-1.5">
            <label for="signup-password" class="block text-xs font-medium text-[#b0b0b0]">
              Password
            </label>
            <input
              type="password"
              id="signup-password"
              name="password"
              autocomplete="new-password"
              required
              placeholder="••••••••••••"
              class="w-full px-3.5 py-2.5 rounded-[6px] bg-[#191919] border border-[#2a2a2a] text-sm text-[#fafafa] placeholder-[#525252] focus:outline-none focus:border-[#fafafa] transition-colors"
            />
            <div id="signup-password-error" class="hidden text-xs text-[#e5484d] pt-1">
              Password must be at least 8 characters.
            </div>
          </div>

          <!-- General Form Alert Banner -->
          <div id="signup-form-alert" class="hidden p-3 rounded-[6px] bg-[#191919] border border-[#e5484d] text-xs text-[#e5484d]">
            Registration failed. Please check your information.
          </div>

          <!-- Submit Button: White Pill shape for primary CTA -->
          <div class="pt-2">
            <button
              type="submit"
              id="signup-submit-btn"
              class="btn-primary-pill w-full justify-center text-sm font-medium"
            >
              Launch Workspace
            </button>
          </div>
        </form>

        <!-- Link to Signin -->
        <div class="text-center pt-2 border-t border-[#2a2a2a] text-xs text-[#7a7a7a]">
          Already have an account?{' '}
          <a href="/signin" class="text-[#fafafa] hover:underline font-medium">
            Sign in
          </a>
        </div>
      </Card>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('signup-form') as HTMLFormElement | null;
  const nameInput = document.getElementById('name') as HTMLInputElement | null;
  const emailInput = document.getElementById('signup-email') as HTMLInputElement | null;
  const passwordInput = document.getElementById('signup-password') as HTMLInputElement | null;
  const nameError = document.getElementById('name-error');
  const emailError = document.getElementById('signup-email-error');
  const passwordError = document.getElementById('signup-password-error');
  const formAlert = document.getElementById('signup-form-alert');

  if (form && nameInput && emailInput && passwordInput) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      let isValid = true;

      // Name check
      const nameVal = nameInput.value.trim();
      if (!nameVal) {
        nameInput.classList.add('!border-[#e5484d]');
        nameError?.classList.remove('hidden');
        isValid = false;
      } else {
        nameInput.classList.remove('!border-[#e5484d]');
        nameError?.classList.add('hidden');
      }

      // Email check
      const emailVal = emailInput.value.trim();
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailVal || !emailRegex.test(emailVal)) {
        emailInput.classList.add('!border-[#e5484d]');
        emailError?.classList.remove('hidden');
        isValid = false;
      } else {
        emailInput.classList.remove('!border-[#e5484d]');
        emailError?.classList.add('hidden');
      }

      // Password check
      const passwordVal = passwordInput.value.trim();
      if (!passwordVal || passwordVal.length < 8) {
        passwordInput.classList.add('!border-[#e5484d]');
        passwordError?.classList.remove('hidden');
        isValid = false;
      } else {
        passwordInput.classList.remove('!border-[#e5484d]');
        passwordError?.classList.add('hidden');
      }

      if (isValid) {
        const submitBtn = document.getElementById('signup-submit-btn') as HTMLButtonElement | null;
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Creating Workspace...';
        }
        if (formAlert) formAlert.classList.add('hidden');

        fetch('/api/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ name: nameVal, email: emailVal, password: passwordVal }),
        })
          .then(async (res) => {
            const data = await res.json().catch(() => ({}));
            if (!res.ok) {
              if (formAlert) {
                formAlert.textContent = data.error || data.message || 'Registration failed. Try again.';
                formAlert.classList.remove('hidden');
              }
            } else {
              window.location.href = '/workspace';
            }
          })
          .catch(() => {
            if (formAlert) {
              formAlert.textContent = 'Connection error. Please try again.';
              formAlert.classList.remove('hidden');
            }
          })
          .finally(() => {
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = 'Launch Workspace';
            }
          });
      }
    });
  }
</script>
